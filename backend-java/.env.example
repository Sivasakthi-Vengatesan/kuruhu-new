# ==============================================================================
# PRAMAAN (ಪ್ರಮಾಣ) — Backend Environment Configuration
# ==============================================================================

# Database Connectivity (PostgreSQL + PGVector)
DATABASE_URL=jdbc:postgresql://localhost:5432/pramaan
DATABASE_USERNAME=pramaan
DATABASE_PASSWORD=change-me

# Server Configuration
PORT=8080

# Security & JWT Secrets (Never commit production secrets to Git)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI / LLM Configuration (OpenAI, Groq, Ollama, or OpenAI-compatible endpoint)
AI_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# Embedding Model Configuration
EMBEDDING_PROVIDER=internal
EMBEDDING_DIMENSION=384

# Text-to-Speech (TTS) Configuration (Zoho Catalyst or Web Speech fallback)
TTS_PROVIDER=zoho
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=
CATALYST_TTS_REFRESH_TOKEN=
CATALYST_ORG=60078981735
CATALYST_REDIRECT_URI=http://www.zoho.com/catalyst
